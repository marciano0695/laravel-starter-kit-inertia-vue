{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "marciano0695/laravel-starter-kit-inertia-vue",
  "type": "project",
  "description": "The skeleton application for the Laravel framework.",
  "keywords": [
    "laravel",
    "framework"
  ],
  "license": "MIT",
  "require": {
    "php": "^8.4.0",
    "inertiajs/inertia-laravel": "^3.0.0-beta",
    "laravel/fortify": "^1.41.0",
    "laravel/framework": "^13.38.0",
    "laravel/tinker": "^3.0.2",
    "laravel/wayfinder": "dev-next",
    "nunomaduro/essentials": "^1.2.0"
  },
  "require-dev": {
    "driftingly/rector-laravel": "^2.7.0",
    "fakerphp/faker": "^1.24.1",
    "larastan/larastan": "^3.13.2",
    "laravel/boost": "^2.10.3",
    "laravel/pail": "^1.2.7",
    "laravel/pao": "^1.1",
    "laravel/pint": "^1.32.1",
    "laravel/vet": "^0.2",
    "mockery/mockery": "^1.6.15",
    "nunomaduro/collision": "^8.9.5",
    "pestphp/pest": "^5.3",
    "pestphp/pest-plugin-browser": "^5.0",
    "pestphp/pest-plugin-laravel": "^5.0",
    "pestphp/pest-plugin-type-coverage": "^5.0",
    "rector/rector": "^2.7.0",
    "roave/security-advisories": "dev-latest"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "setup": [
      "composer install",
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
      "@php artisan key:generate",
      "@php artisan migrate --force",
      "@php artisan storage:link",
      "npm install",
      "npm run build"
    ],
    "dev": [
      "Composer\\Config::disableProcessTimeout",
      "@php artisan dev"
    ],
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "post-update-cmd": [
      "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
      "@php artisan clear",
      "@update:requirements"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi",
      "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
      "@php artisan migrate --graceful --ansi"
    ],
    "pre-package-uninstall": [
      "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
    ],
    "update:requirements": [
      "composer bump",
      "npx npm-check-updates -u"
    ],
    "lint": [
      "rector",
      "pint --parallel",
      "npm run lint"
    ],
    "test:type-coverage": "pest --type-coverage --memory-limit=1G --min=100.0",
    "test:lint": [
      "pint --parallel --test",
      "rector --dry-run",
      "npm run test:lint"
    ],
    "test:unit": "pest --parallel --coverage --exactly=100.0",
    "test:types": [
      "phpstan --memory-limit=1G",
      "npm run test:types"
    ],
    "test": [
      "@test:lint",
      "@test:types",
      "@test:type-coverage",
      "@test:unit"
    ]
  },
  "extra": {
    "laravel": {
      "dont-discover": []
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "php-http/discovery": true,
      "laravel/vet": true
    }
  },
  "minimum-stability": "beta",
  "prefer-stable": true
}
